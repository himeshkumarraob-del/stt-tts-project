# Environment Configuration
APP_NAME="Voice Learning & Accent Analysis Backend"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Settings (JSON list or comma separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# Audio Settings & Constraints
MAX_AUDIO_SIZE_BYTES=26214400 # 25 MB
ALLOWED_AUDIO_EXTENSIONS=["wav","mp3","m4a","ogg","flac","aac","webm"]
MIN_AUDIO_DURATION_SEC=0.5
MAX_AUDIO_DURATION_SEC=120.0

# Speech-to-Text (STT) Settings
STT_PROVIDER=faster-whisper
STT_MODEL=base.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en
STT_BEAM_SIZE=5

# AI Feedback & LLM Settings (Phase 5)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
LLM_TIMEOUT_SECONDS=15.0
LLM_TEMPERATURE=0.3

# Text-to-Speech (TTS) Settings (Phase 6)
TTS_PROVIDER=openai
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_AUDIO_FORMAT=mp3
TTS_TIMEOUT_SECONDS=15.0
TTS_MAX_TEXT_LEN=4096

# Database Settings (Phase 6)
DB_PATH=voice_learning.db

# Logging
LOG_LEVEL=INFO
