# ── Server ────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# ── STT provider selection ───────────────────────────────────────────────
# "deepgram" (recommended: real-time streaming, native en-IN model, per-word
#             confidence, works well on Indian English) or "whisper"
# (recommended for highest batch accuracy on heavy code-switching/noise;
#             no native streaming, so it is used for the "upload/finalize"
#             path and as the streaming fallback when Deepgram is unset).
STT_PROVIDER=deepgram

DEEPGRAM_API_KEY=1c7fa28023a0d9d5eae0dbb7adaaa0adc87ff047
# Model tuned for Indian speakers. "nova-2" supports language=multi and
# an en-IN locale; check your Deepgram console for the latest model name.
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en-IN

OPENAI_API_KEY=
# whisper-1 or gpt-4o-transcribe, depending on account access
OPENAI_STT_MODEL=whisper-1

# Below this per-word confidence (0-1), the word is flagged "uncertain"
# in the transcript instead of being silently kept or dropped.
LOW_CONFIDENCE_THRESHOLD=0.55

# ── TTS provider selection ───────────────────────────────────────────────
# "azure" (best Indian-language + Indian-English neural voice coverage:
#          en-IN, hi-IN, ta-IN, te-IN, kn-IN, ml-IN, bn-IN, mr-IN, gu-IN...)
# "sarvam" (recommended if you don't want to add a card anywhere: Indian
#           company, model trained natively on Indic speech, free tier
#           issues API keys instantly with no card required)
# or "elevenlabs" (very natural English; free tier does NOT support
#           premade/library voices via the API as of 2026 — needs a paid
#           plan to actually work)
TTS_PROVIDER=sarvam

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

ELEVENLABS_API_KEY=

SARVAM_API_KEY=sk_kqi6q9ia_Mv6J8inAkf3anOI0ned4eHFx
# bulbul:v3 (recommended) or bulbul:v2
SARVAM_TTS_MODEL=bulbul:v3

# ── Uploads ───────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
